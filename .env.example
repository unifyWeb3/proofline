# Proofline environment template
#
# Every value below is intentionally blank or a non-writing safe default.
# Never put a private key, token, wallet secret, or deployed address here.
# Local schema, fixture, and direct-mode tests require no .env file.

# Read-only network verification (public; conditional)
GENLAYER_RPC_URL=
GENLAYER_CHAIN_ID=
GENLAYER_EXPLORER_URL=

# Account metadata (public; conditional)
GENLAYER_ACCOUNT_ADDRESS=

# Signed deployment or hosted writes (secret; conditional)
GENLAYER_PRIVATE_KEY=

# Application-side write guard; not an official GenLayer CLI variable.
GENLAYER_DEPLOYMENT_MODE=read-only

# Future hosted fee configuration. These names are intentionally blank and are
# not read by the local MVP; the stable SDK requires an SDK-generated estimate.
GENLAYER_FEE_PROFILE=
GENLAYER_GAS_LIMIT=

# Populate only after a real deployment has been observed and recorded.
GENLAYER_CONTRACT_ADDRESS=

# Evidence policy (public; conditional). The current MVP uses generated,
# hash-bound embedded fixtures; live retrieval is future-only.
EVIDENCE_FETCH_ALLOWLIST=
EVIDENCE_FIXTURE_ROOT=

# Future-only evidence storage (not used by the MVP)
EVIDENCE_STORAGE_URL=
EVIDENCE_STORAGE_TOKEN=

# Reserved future frontend configuration (not read by the core or tests)
NEXT_PUBLIC_GENLAYER_RPC_URL=
NEXT_PUBLIC_GENLAYER_CHAIN_ID=
NEXT_PUBLIC_GENLAYER_EXPLORER_URL=
NEXT_PUBLIC_PROOFLINE_CONTRACT_ADDRESS=
